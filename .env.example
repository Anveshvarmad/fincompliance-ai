POSTGRES_USER=finuser
POSTGRES_PASSWORD=finpassword
POSTGRES_DB=fincompliance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MONGO_URL=mongodb://mongo:27017
MONGO_DB=fincompliance

CHROMA_HOST=chroma
CHROMA_PORT=8000

EVENT_SERVICE_URL=http://event-service:3001

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

VITE_API_URL=http://localhost:8000
CHROMA_COLLECTION=compliance_policies_v1

# Phase 9 security / observability
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_ISSUER=fincompliance-ai

AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD_SALT=replace-me
AUTH_VIEWER_PASSWORD_HASH=replace-me

AUTH_ANALYST_USERNAME=analyst
AUTH_ANALYST_PASSWORD_SALT=replace-me
AUTH_ANALYST_PASSWORD_HASH=replace-me

AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD_SALT=replace-me
AUTH_ADMIN_PASSWORD_HASH=replace-me

RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=INFO

# Phase 11 RabbitMQ / Transactional Outbox
RABBITMQ_USER=finapp
RABBITMQ_PASSWORD=replace-with-secure-password
RABBITMQ_URL=amqp://finapp:replace-with-secure-password@rabbitmq:5672/
RABBITMQ_QUEUE=compliance.audit.events
OUTBOX_ENABLED=true
